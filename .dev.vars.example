# Copy to .dev.vars for local development (`wrangler dev` reads it automatically).
ADMIN_API_KEY=dev-admin-key

# LLM provider — set ONE of these. OPENROUTER_API_KEY wins when both are set.
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# Optional OpenRouter model overrides (defaults shown):
# OPENROUTER_MODEL_AGENT=anthropic/claude-sonnet-4.6
# OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5

# GOOGLE_PLACES_API_KEY=...
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# RECAP_EMAIL=owner@example.com
# SENDER_EMAIL=outreach@yourdomain.com
# SENDER_NAME=Your Name
# VERIFIER_API_KEY=...
